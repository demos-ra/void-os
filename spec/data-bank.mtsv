create exclusively	python	with open({{path}}, 'xb'): pass	PY-FUNCTIONS	Built-in Functions	254	254
create exclusively	javascript	fs.closeSync(fs.openSync({{path}}, 'wx'));	NODE-FS	File system flags		
remove	python	os.unlink({{path}})	PY-OS	Files and Directories	445	445
