start process	javascript	const {{result}} = ((child) => { const handle = { child, stdout: new Uint8Array(0), stderr: new Uint8Array(0), read: 0, status: null, closed: false, wake: () => {} }; const join = (head, tail) => { const joined = new Uint8Array(head.length + tail.length); joined.set(head); joined.set(tail, head.length); return joined; }; child.stdout.on('data', (chunk) => { handle.stdout = join(handle.stdout, chunk); handle.wake(); }); child.stderr.on('data', (chunk) => { handle.stderr = join(handle.stderr, chunk); }); child.on('close', (status) => { handle.status = status; handle.closed = true; handle.wake(); }); return handle; })(child_process.spawn({{arguments}}[0], {{arguments}}.slice(1), { cwd: {{folder}}, env: {{environment}} }));	NODE-CHILD-PROCESS	child_process.spawn(command[, args][, options])		
