server.4	1	1	{"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "read", "arguments": {"pathname": "$PWD/d/a.mtsv"}, "_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientInfo": {"name": "conformance", "version": "1"}, "io.modelcontextprotocol/clientCapabilities": {}}}}
