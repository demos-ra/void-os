database statements
requirement	case	pathname	statement	text
sqlite.1	1	$PWD/d/q.sqlite	1	CREATE TABLE t (a, b)
sqlite.1	1	$PWD/d/q.sqlite	2	CREATE VIEW v AS SELECT a FROM t
sqlite.1	1	$PWD/d/q.sqlite	3	CREATE INDEX i ON t (b)
sqlite.1	1	$PWD/d/q.sqlite	4	INSERT INTO t VALUES (1, 'x')
sqlite.2	1	$PWD/d/b.sqlite	1	CREATE TABLE t (a)
sqlite.2	1	$PWD/d/b.sqlite	2	INSERT INTO t VALUES (x'0001')
