order.1	1	2	0	{"title": "t", "type": "object", "properties": {"a": {"type": "string"}, "b": {"type": "array", "items": {"type": "string"}}, "c": {}}, "required": ["a", "c"]}
order.1	1	3	0	0
order.2	1	1	1	{"a": "b"}
order.2	1	1	2	{"a": "a"}
