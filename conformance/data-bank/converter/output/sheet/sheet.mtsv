t and kind d	1	2	1	0
t and kind d	2	0	1	d
t and kind d	2	1	1	_input value
t and kind d	2	1	2	_instance
t and kind d	2	1	3	_parent
t and kind d	2	1	4	_pointer
t and kind d	2	1	5	v
t and kind d	2	2	1	0
t and kind d	2	2	2	1
t and kind d	2	2	3	0
t and kind d	2	2	4	/p
t and kind d	2	2	5	x
t __x y	1	0	1	t
t __x y	1	1	1	_input value
t __x y	1	1	2	__x
t __x y	1	2	1	0
t __x y	1	2	2	y
placed
requirement	case	when	pathname	fixture
sheet.1	1	after	result 1	t a x
sheet.2	1	after	result 1	t and kind d
sheet.3	1	after	result 1	t __x y
sheet.4	1	after	result 1	t and t.b
sheet.5	1	after	result 1	o.v column
